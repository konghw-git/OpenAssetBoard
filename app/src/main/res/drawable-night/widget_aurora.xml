<?xml version="1.0" encoding="utf-8"?>
<!-- Glass over the wallpaper: a translucent body, two soft colour fields like the app's ambient page, a lit rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="315" android:startColor="#F22A1712" android:endColor="#F2231014" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.92" android:centerY="0.04" android:gradientRadius="70%p" android:startColor="#55FF8A3D" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:type="radial" android:centerX="0.04" android:centerY="1.0" android:gradientRadius="65%p" android:startColor="#40D94A78" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#40FFD9C2" />
        </shape>
    </item>
</layer-list>
