# Example site block. Add it to the Caddyfile that already serves this machine,
# then validate and reload (no need to restart Caddy):
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# If another service already owns 443 (for example a sing-box relay), give the
# site an explicit port instead of the default; clients then use
# https://asset.example.com:9443. Caddy still gets the certificate over HTTP-01
# on port 80, so port 80 must be reachable.
asset.example.com:9443 {
    encode zstd gzip
    reverse_proxy 127.0.0.1:18090
}
